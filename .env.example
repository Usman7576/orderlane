# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# Inside Docker Compose the hosts are "postgres" and "redis".
# For tools run on your machine against the Compose services, use localhost.
DATABASE_URL=postgresql+asyncpg://orderlane:orderlane@postgres:5432/orderlane
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=change-me

# Folder for downloaded audio and generated invoices
STORAGE_DIR=/app/storage

# --- WhatsApp Cloud API (Meta developer app) ---
WA_GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Send read receipts for incoming messages
WA_MARK_AS_READ=true

# --- Azure OpenAI ---
# Leave empty to run the agent with rules only (no LLM).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_SMALL=
AZURE_OPENAI_DEPLOYMENT_LARGE=
# USD per 1M tokens for your model, used for cost estimates on each agent run
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

# --- Azure AI Speech (free F0 tier is enough) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Each language is tried; the most confident transcript wins. ur-PK returns Urdu script.
SPEECH_LANGUAGES=ur-PK,en-US

# --- Agent ---
# azure, or rules to switch the LLM off
LLM_PROVIDER=azure
MATCH_CONFIDENCE_MIN=0.85
FUZZY_ACCEPT=0.85
REVIEW_ABOVE_TOTAL=100000
CONFIRM_DEBOUNCE_SECONDS=10

# --- Optional tracing ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Seed data ---
SEED_ADMIN_EMAIL=admin@orderlane.test
# Leave empty to generate a random password (printed once by the seed script)
SEED_ADMIN_PASSWORD=
